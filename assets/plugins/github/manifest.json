{
  "schemaVersion": 2,
  "id": "github",
  "name": "GitHub · gh 与 Git",
  "description": "官方 ARM64 gh，附带本地配置服务；配合 GitHub Web 插件完成 Token、SSH、仓库与 PR 操作。",
  "version": "1.0.1",
  "publisher": "TaiXu Community",
  "category": "DEVELOPER",
  "homepage": "https://cli.github.com/",
  "architectures": [
    "ARM64"
  ],
  "launchType": "web",
  "servicePort": 18765,
  "servicePath": "/",
  "source": "LOCAL",
  "offlineOnly": true,
  "installMethod": "LOCAL_PACKAGE",
  "dependencies": [
    "python",
    "git",
    "ca-certificates"
  ],
  "permissions": [
    "NETWORK",
    "WORKSPACE_READ",
    "WORKSPACE_WRITE",
    "LOCAL_WEB"
  ],
  "installSteps": [
    "/bin/sh \"$TAIXU_PLUGIN_PAYLOAD/scripts/install.sh\""
  ],
  "launchCommand": "gh-ui serve",
  "verifyCommand": "gh --version",
  "commandLinks": [
    "gh",
    "gh-ui",
    "gh-git"
  ],
  "plugin": {
    "id": "community.github",
    "api": {
      "minimum": 1,
      "maximum": 1
    },
    "execution": "PROCESS",
    "extensions": [
      {
        "id": "launch",
        "point": "PROCESS"
      }
    ],
    "capabilities": [
      {
        "name": "NETWORK",
        "target": "github.com"
      },
      {
        "name": "LOCAL_WEB",
        "target": "authenticated-v1"
      }
    ],
    "integrity": {
      "bin/gh": "cd39986b653e19e8b936b684b47b96611adf2d59216e6c766730708e54d91350",
      "bin/gh-git": "01591a23210011b097fb0d1e35035ef5bf487ab78591e915e0203d86f7bbc158",
