      "lib/github_plugin.py": "cb5ddb9a15741d6b89c4b8ca9ca45c87625d58d4fe20cebc5b952720eb22a5d3",
      "lib/service_protocol.py": "bd429020c7fa52a3dde8aacb21a174d752e39e72906241037023c4128a7104fd",
