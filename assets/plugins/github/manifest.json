      "lib/github_plugin.py": "175f5ba8d0895a4c2fe930fe53bdbe76d0f49bc9a8f6452369f937da9a20e286",
      "lib/service_protocol.py": "cffe30db2ec57474f340a68904ba9553c0a542ff948a614d1d4b99a5c80ae63c",
      "scripts/install.sh": "5b3e6b1e5b0f3184e975ee633f2d4d506594ebd431d94bd5be56a411e6e1f0b6",
      "vendor/gh": "a82a52e1bbe05bcd485f8cbbd5aa67e11a76fce6bdad394a2d179e1c24cfe367",
