#!/bin/sh
set -eu
tool=/opt/taixu/tools/yazi
data=/opt/taixu/data/yazi
case "${1:-}" in
  --version|--debug)
    exec "$tool/libexec/yazi" "$@"
    ;;
esac
if [ ! -t 0 ] || [ ! -t 1 ]; then
  echo '请在原生交互终端中运行 yazi' >&2
  exit 1
fi
umask 077
mkdir -p "$data/config"
if [ ! -f "$data/config/yazi.toml" ]; then
  cp "$tool/config/yazi.toml" "$data/config/yazi.toml"
fi
export YAZI_CONFIG_HOME="$data/config"
export TERM="${TERM:-xterm-256color}"
exec "$tool/libexec/yazi" "$@"
