#!/bin/sh
set -eu
umask 077
tool_dir=${TAIXU_TOOL_DIR:-/opt/taixu/tools/cc-switch}
data_dir=${CC_SWITCH_DATA_DIR:-${TAIXU_TOOL_DATA:-/opt/taixu/data/cc-switch}/official-v4}
port=${CC_SWITCH_PORT:-19870}
while [ "$#" -gt 0 ]; do
    case "$1" in
        --version|-v) exec "$tool_dir/lib/cc-switch-server" --version ;;
        --verify)
            test -s "$tool_dir/ui/index.html"
            exec "$tool_dir/lib/cc-switch-server" --version ;;
        --port) test "$#" -ge 2 || exit 2; port=$2; shift 2 ;;
        --data-dir) test "$#" -ge 2 || exit 2; data_dir=$2; shift 2 ;;
        --help|-h) echo 'Usage: cc-switch-daemon [--port PORT] [--data-dir DIR] [--verify|--version]'; exit 0 ;;
        *) echo "Unknown option: $1" >&2; exit 2 ;;
    esac
done
case "$data_dir" in /*) ;; *) echo 'Data directory must be absolute' >&2; exit 2 ;; esac
mkdir -p "$data_dir"
chmod 700 "$data_dir"
export CC_SWITCH_DATA_DIR="$data_dir" CC_SWITCH_PORT="$port"
export CC_SWITCH_UI_DIR="$tool_dir/ui"
# Keep the CLI user's HOME. The old Web-fork database and symlink stay intact.
exec "$tool_dir/lib/cc-switch-server"
