{
  "schemaVersion": 1,
  "id": "cc-switch",
  "name": "CC Switch Web",
  "description": "官方 v4.0.30 的太墟 Web 移植版，含官方前端、提供商管理、路由与隐私过滤。插件中心启动/停止，本机端口 19870；首次登录密码位于独立 official-v4 数据目录的 web_password 文件。",
  "version": "4.0.30",
  "latestVersion": "4.0.30",
  "publisher": "farion1231 / TaiXu Web adapter",
  "homepage": "https://github.com/farion1231/cc-switch",
  "category": "AI_AGENT",
  "launchType": "web",
  "servicePort": 19870,
  "servicePath": "/",
  "architectures": ["ARM64"],
  "permissions": ["NETWORK", "WORKSPACE_READ", "WORKSPACE_WRITE", "LOCAL_WEB"],
  "updateStrategy": "REINSTALL",
  "source": "LOCAL",
  "offlineOnly": true,
  "installMethod": "LOCAL_PACKAGE",
  "installSteps": [
    "/bin/sh \"$TAIXU_PLUGIN_PAYLOAD/scripts/install.sh\""
  ],
  "uninstallSteps": [
    "/bin/sh \"$TAIXU_PLUGIN_PAYLOAD/scripts/uninstall.sh\""
  ],
  "launchCommand": "cc-switch-daemon",
  "verifyCommand": "/bin/sh \"$TAIXU_PLUGIN_PAYLOAD/scripts/verify.sh\"",
  "commandLinks": ["cc-switch-daemon"],
  "environment": {
    "CC_SWITCH_PORT": "19870",
    "CC_SWITCH_DATA_DIR": "/opt/taixu/data/cc-switch/official-v4"
  }
}
