#!/bin/sh
# TaiXu-managed Gradle entry. Set TAIXU_BUILD_GUARD_BYPASS=1 only for a
# deliberate non-Android diagnostic invocation.
if [ "${TAIXU_BUILD_GUARD_BYPASS:-0}" = "1" ] || [ "${TAIXU_BUILD_ENGINE:-0}" = "1" ]; then
    # Gradle 版本随工具链升级而变，写死版本号会在升级后指向不存在的目录。
    # 取 /opt 下最高正式版（过滤 rc/beta/alpha/preview/snapshot），与 taixu-build.sh 同一口径。
    grep_v='rc|beta|alpha|preview|snapshot'
    gradle_home="${GRADLE_HOME:-$(ls -d /opt/gradle-*/ 2>/dev/null | grep -Eiv "$grep_v" | sort -V | tail -n 1 | sed 's#/$##')}"
    if [ -n "$gradle_home" ] && [ -x "$gradle_home/bin/gradle" ]; then
        exec "$gradle_home/bin/gradle" "$@"
    fi
    exec /usr/bin/gradle "$@"
fi
exec /bin/sh /opt/taixu/bin/taixu-build-guard gradle "$@"
