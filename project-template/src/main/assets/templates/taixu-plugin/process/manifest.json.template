    "cp \"$TAIXU_PLUGIN_PAYLOAD/bin/{{toolId}}\" \"$TAIXU_TOOL_DIR/bin/{{toolId}}\" && chmod 755 \"$TAIXU_TOOL_DIR/bin/{{toolId}}\""
